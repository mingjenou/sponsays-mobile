{
  "expo": {
    "name": "SponSays",
    "slug": "sponsays",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sponsays",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FFFCF7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sponsays.preview"
    },
    "android": {
      "package": "com.sponsays.preview",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFCF7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SponSays to use your location once to find relevant places nearby."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
